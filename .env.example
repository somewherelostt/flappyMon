# Database
DATABASE_URL="postgresql://ad402_user:your_password@localhost:5432/ad402_db"

# Lighthouse/IPFS Storage
LIGHTHOUSE_API_KEY=your_lighthouse_api_key_here
LIGHTHOUSE_STORAGE_HASH=QmPq7ugnMazhVVVko9ZU7LxFgM7U1Zs3Ly5tat7hMJ8aYA

# Blockchain RPC Endpoints (Monad Testnet)
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz/

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://mon-ad.io

# Payment Configuration
PAYMENT_RECIPIENT=0x6d63C3DD44983CddEeA8cB2e730b82daE2E91E32

# Facilitator / Worker
FACILITATOR_PRIVATE_KEY=your_evm_private_key_here

# Platform Settings
PLATFORM_FEE_PERCENTAGE="5"
UPLOAD_DIR="./public/uploads/ads"
MAX_FILE_SIZE="10485760"
ANALYTICS_ENABLED="true"

# Security
JWT_SECRET=""
ENCRYPTION_KEY=""

# Network Configuration
NEXT_PUBLIC_NETWORK="monad-testnet"
NEXT_PUBLIC_CURRENCY="MON"
NEXT_PUBLIC_API_BASE_URL="/api"
NEXT_PUBLIC_RAINBOWKIT_PROJECT_ID=your_reown_project_id

# Application
NODE_ENV=development
PORT=3000